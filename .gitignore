# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Dữ liệu lớn (Tránh đẩy lên GitHub gây lỗi vượt quota 100MB)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/olist_clean.parquet
!data/processed/olist_clustered.parquet
!data/processed/experience_features.csv

# Excel temporary / lock files
~$*.xlsx
~$*.xls

# Model weights & large artifacts
*.pkl
*.joblib
*.h5

# OS generated files
.DS_Store
Thumbs.db

# IDE configuration
.vscode/
.idea/
